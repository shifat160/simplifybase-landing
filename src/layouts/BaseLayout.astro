---
import { SITE, PRODUCTION_HOST } from '~/site';
import '~/styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative image for og:image. */
  image?: string;
  /** Overrides the canonical URL; defaults to the current path. */
  canonical?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Hex colour applied as --sb-accent for this page only (product pages). */
  accent?: string;
  bodyClass?: string;
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  canonical,
  type = 'website',
  noindex = false,
  accent,
  bodyClass = '',
} = Astro.props;

// `title` is the page's own name; the suffix is appended unless the page is
// the home page, whose title is already the full brand string.
const fullTitle = title === SITE.name ? title : `${title} — ${SITE.name}`;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(image, Astro.site);

// Any host that is not production gets noindex, whatever the page asked for.
// A preview deployment on a public URL is otherwise indexable, and it competes
// with the real site for the same content.
const isProduction = canonicalUrl.hostname === PRODUCTION_HOST;
const blockIndexing = noindex || !isProduction;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} blog`}
      href="/rss.xml"
    />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {blockIndexing && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/*
      Applies the stored theme before the first paint. This must stay inline
      and un-deferred: a bundled module would run after the browser has already
      painted the light default, flashing the wrong theme on dark-mode reloads.
      No stored preference means we follow the OS.
    */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('sb-theme');
          const theme =
            stored ??
            (window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light');
          document.documentElement.dataset.theme = theme;
        } catch {
          /* private mode / blocked storage — the light default stands */
        }
      })();
    </script>

    {/*
      Per-product tint. Scoped to :root because the accent is also read by
      utilities defined outside this subtree (focus rings, ::selection).

      The selector is doubled — `:root:root` — on purpose. Astro emits
      global.css as a <link> that lands after this inline <style>, so a plain
      `:root` here ties on specificity and loses on order, and the product
      accent silently falls back to the SimplifyBase amber. Doubling wins
      without resorting to !important, which would break the light-mode rule
      below.

      The FILL keeps its true hue in both themes. Every product accent is
      picked bright enough that near-black ink sits on it at 7:1 or better, so
      there is nothing to gain by darkening it — and a darkened fill turns a
      full-bleed hero band muddy, which is where these colours do most of their
      work.

      Only the TEXT variant has to move: the raw hue as text on white is around
      2.6:1, so light mode mixes it most of the way to black, and dark mode
      keeps it bright.
    */}
    {
      accent && (
        <style
          set:html={`:root:root{--sb-accent:${accent};--sb-accent-ink:#16130f;` +
            `--sb-accent-text:color-mix(in oklab,${accent} 55%,black);}` +
            `:root:root[data-theme='dark']{--sb-accent-text:${accent};}`}
        />
      )
    }

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:text-accent-ink"
      >Skip to content</a
    >
    <slot />

    {/*
      Drives the `reveal` utility. Deliberately tiny and dependency-free: the
      elements are visible by default under reduced motion, so a failure here
      degrades to no animation rather than to invisible content.
    */}
    <script>
      /*
        Drives both reveal systems: `.reveal` (one element) and `[data-blocks]`
        (a container whose children stagger in). The observer only adds a
        class — all timing lives in CSS, so a busy main thread cannot desync a
        sequence mid-flight.

        Fails OPEN. Without IntersectionObserver, or under reduced motion,
        everything is marked revealed immediately; a reveal that fails closed
        leaves a blank page.
      */
      const targets = document.querySelectorAll('.reveal, [data-blocks]');

      const revealAll = () =>
        targets.forEach((el) => el.classList.add('is-revealed'));

      if (
        !targets.length ||
        !('IntersectionObserver' in window) ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        revealAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        targets.forEach((el) => io.observe(el));

        // Anything already on screen at load should animate now rather than
        // wait for a scroll that may never come on a short page.
        requestAnimationFrame(() => {
          for (const el of targets) {
            const r = el.getBoundingClientRect();
            if (r.top < window.innerHeight && r.bottom > 0) {
              el.classList.add('is-revealed');
              io.unobserve(el);
            }
          }
        });
      }
    </script>
  </body>
</html>
