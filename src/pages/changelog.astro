---
import MarketingLayout from '~/layouts/MarketingLayout.astro';
import CtaBand from '~/components/sections/CtaBand.astro';
import ChangelogList from '~/components/sections/ChangelogList.astro';
import { getReleases, productChangelogHref, releaseProduct } from '~/lib/changelog';
import { getProducts } from '~/lib/products';

/**
 * The combined feed. Each product also has its own changelog at
 * /product/<slug>/changelog/, and each release its own page — those are what
 * to link to; this page is for skimming the whole family at once.
 */
const releases = await getReleases();
const products = await getProducts();
const bySlug = new Map(products.map((p) => [p.data.slug, p]));
const withReleases = products.filter((p) =>
  releases.some((r) => releaseProduct(r) === p.data.slug),
);
---

<MarketingLayout
  title="Changelog"
  description="What shipped, and when, across the SimplifyBase products."
>
  <section class="border-b border-line">
    <div class="container-page pt-16 pb-12 sm:pt-20 sm:pb-14">
      <div class="flex max-w-3xl flex-col items-start gap-5">
        <p class="text-eyebrow">Changelog</p>
        <h1 class="text-headline">What shipped, and when</h1>
        <p class="max-w-xl text-base leading-relaxed text-muted">
          Every release across the product family. Bug fixes included — a
          changelog that only lists features is a marketing page.
        </p>
        <nav aria-label="Changelog by product" class="flex flex-wrap gap-2 pt-2">
          {
            withReleases.map((p) => (
              <a
                href={productChangelogHref(p.data.slug)}
                class="rounded-full border border-line px-3 py-1 text-sm text-muted transition-colors hover:border-line-strong hover:text-ink"
              >
                {p.data.name}
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </section>

  <div class="container-page py-14 sm:py-20">
    <ChangelogList releases={releases} products={bySlug} />
  </div>

  <CtaBand
    heading="Follow along"
    lede="Releases, and the thinking behind them, go out on the blog."
    primary={{ label: 'Read the blog', href: '/blog/' }}
    secondary={{ label: 'Subscribe by RSS', href: '/rss.xml' }}
  />
</MarketingLayout>
