---
import type { GetStaticPaths } from 'astro';
import MarketingLayout from '~/layouts/MarketingLayout.astro';
import Section from '~/components/ui/Section.astro';
import PostList from '~/components/blog/PostList.astro';
import { getPosts, POSTS_PER_PAGE } from '~/lib/blog';

/**
 * Pages 2..n only. Page 1 is /blog/ — emitting it here as well would give the
 * same list two URLs and split its ranking.
 */
export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: {
        page,
        totalPages,
        posts: posts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE),
      },
    };
  });
}) satisfies GetStaticPaths;

const { page, totalPages, posts } = Astro.props;

const prevHref = page === 2 ? '/blog/' : `/blog/page/${page - 1}/`;
const nextHref = page < totalPages ? `/blog/page/${page + 1}/` : null;
---

<MarketingLayout
  title={`Blog — page ${page}`}
  description="Notes on inventory, automation and building focused software, from the team at SimplifyBase."
>
  <section class="border-b border-line">
    <div class="container-page pt-16 pb-12 sm:pt-20 sm:pb-14">
      <p class="text-eyebrow mb-5">Blog · page {page}</p>
      <h1 class="text-headline">Older posts</h1>
    </div>
  </section>

  <Section>
    <PostList posts={posts} />

    <nav
      aria-label="Pagination"
      class="mt-12 flex items-center justify-between gap-4"
    >
      <a
        href={prevHref}
        class="text-sm text-ink transition-colors hover:text-accent-text"
        >← Newer posts</a
      >
      <span class="font-mono text-xs text-faint">
        Page {page} of {totalPages}
      </span>
      {
        nextHref ? (
          <a
            href={nextHref}
            class="text-sm text-ink transition-colors hover:text-accent-text"
          >
            Older posts →
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </Section>
</MarketingLayout>
