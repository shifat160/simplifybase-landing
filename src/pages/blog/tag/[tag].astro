---
import type { GetStaticPaths } from 'astro';
import MarketingLayout from '~/layouts/MarketingLayout.astro';
import Section from '~/components/ui/Section.astro';
import PostList from '~/components/blog/PostList.astro';
import { getPosts, getTags, tagSlug, tagHref } from '~/lib/blog';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const tags = await getTags();

  return tags.map(({ tag, slug }) => ({
    params: { tag: slug },
    props: {
      tag,
      // Match on the slug, not the raw string, so tags differing only in case
      // or punctuation land in the same archive the tag list links to.
      posts: posts.filter((p) => p.data.tags.some((t) => tagSlug(t) === slug)),
    },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
const allTags = await getTags();
---

<MarketingLayout
  title={`Posts tagged ${tag}`}
  description={`SimplifyBase blog posts about ${tag}.`}
>
  <section class="border-b border-line">
    <div class="container-page pt-16 pb-12 sm:pt-20 sm:pb-14">
      <p class="text-eyebrow mb-5">Tag</p>
      <h1 class="text-headline">{tag}</h1>
      <p class="mt-4 text-base text-muted">
        {posts.length}
        {posts.length === 1 ? 'post' : 'posts'}
      </p>

      <ul class="mt-8 flex flex-wrap gap-2">
        <li>
          <a
            href="/blog/"
            class="inline-block rounded-full border border-line px-3 py-1 font-mono text-[0.6875rem] tracking-wide text-muted uppercase transition-colors hover:border-line-strong hover:text-ink"
            >All posts</a
          >
        </li>
        {
          allTags
            .filter((t) => t.tag !== tag)
            .map((t) => (
              <li>
                <a
                  href={tagHref(t.tag)}
                  class="inline-block rounded-full border border-line px-3 py-1 font-mono text-[0.6875rem] tracking-wide text-muted uppercase transition-colors hover:border-line-strong hover:text-ink"
                >
                  {t.tag}
                </a>
              </li>
            ))
        }
      </ul>
    </div>
  </section>

  <Section>
    <PostList posts={posts} />
  </Section>
</MarketingLayout>
