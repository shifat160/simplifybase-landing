---
import MarketingLayout from '~/layouts/MarketingLayout.astro';
import Badge from '~/components/ui/Badge.astro';
import ProductIcon from '~/components/ui/ProductIcon.astro';
import SiteSearch from '~/components/search/SiteSearch.astro';
import { getProducts, productDocsHref, STATUS_LABEL } from '~/lib/products';
import { buildSidebar, docHref, docSlug, getDocsForProduct } from '~/lib/docs';
import { getReleases, productChangelogHref } from '~/lib/changelog';

/**
 * /docs/ — the front door to every product's documentation. Each product's
 * docs still live under its own URL (/product/<slug>/docs/); this page only
 * routes people there, with each product's first few pages one click away.
 */
const products = await getProducts();

const cards = (
  await Promise.all(
    products.map(async (product) => {
      const docs = await getDocsForProduct(product.data.slug);
      if (docs.length === 0) return null;
      // The first pages of the sidebar, in reading order, minus the root.
      const pages = buildSidebar(docs)
        .flatMap((g) => g.items)
        .filter((d) => docSlug(d) !== '')
        .slice(0, 5);
      const releases = await getReleases(product.data.slug);
      return { product, count: docs.length, pages, hasReleases: releases.length > 0 };
    }),
  )
).filter((c) => c !== null);
---

<MarketingLayout
  title="Documentation"
  description="Documentation for every SimplifyBase product: installation, setup, how each feature works, and reference."
>
  <section class="border-b border-line">
    <div class="container-page pt-16 pb-12 sm:pt-20 sm:pb-14">
      <div class="flex max-w-3xl flex-col items-start gap-5">
        <p class="text-eyebrow">Docs</p>
        <h1 class="text-headline">Documentation</h1>
        <p class="max-w-xl text-base leading-relaxed text-muted">
          Each product has its own docs. Pick one below, or search all of them
          at once.
        </p>
        <div class="w-full max-w-md pt-2">
          <SiteSearch filterKey="type" filterValue="docs" scope="all docs" />
        </div>
      </div>
    </div>
  </section>

  <div class="container-page py-14 sm:py-20">
    <ul class="grid gap-px border border-line bg-line md:grid-cols-2">
      {
        cards.map(({ product, count, pages, hasReleases }, i) => {
          const p = product.data;
          return (
            <li
              class:list={[
                'reveal flex flex-col gap-5 bg-bg p-6 sm:p-8',
                // An odd count would leave an empty tile; the last one spans.
                cards.length % 2 === 1 && i === cards.length - 1 && 'md:col-span-2',
              ]}
              style={p.accent ? `--sb-accent:${p.accent}` : undefined}
            >
              <div class="flex items-start justify-between gap-4">
                <a href={productDocsHref(p.slug)} class="group flex items-center gap-3">
                  <span class="docs-icon"><ProductIcon slug={p.slug} class="size-5" /></span>
                  <span class="flex flex-col">
                    <span class="text-title text-ink group-hover:underline">{p.name}</span>
                    <span class="text-sm text-muted">{p.tagline}</span>
                  </span>
                </a>
                <Badge tone={p.status}>{STATUS_LABEL[p.status]}</Badge>
              </div>

              {pages.length > 0 ? (
                <ul class="flex flex-col border-t border-line">
                  {pages.map((d) => (
                    <li class="border-b border-line">
                      <a href={docHref(d)} class="flex items-center justify-between gap-4 py-2.5 text-sm text-body hover:text-ink">
                        {d.data.sidebarLabel ?? d.data.title}
                        <span aria-hidden="true" class="text-faint">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="text-sm leading-relaxed text-muted">
                  {p.status === 'planned'
                    ? 'In design — the docs outline is published so the address stays the same.'
                    : 'Getting started and the planned outline are up; more pages are on the way.'}
                </p>
              )}

              <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-2 pt-1 text-sm">
                <a href={productDocsHref(p.slug)} class="font-medium text-ink hover:underline">
                  {p.name} docs →
                </a>
                <span class="font-mono text-xs text-faint">
                  {count} {count === 1 ? 'page' : 'pages'}
                </span>
                {hasReleases && (
                  <a href={productChangelogHref(p.slug)} class="text-muted hover:text-ink">
                    Changelog
                  </a>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</MarketingLayout>

<style>
  .docs-icon {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    flex-shrink: 0;
    border-radius: 0.5rem;
    background-color: var(--sb-accent);
    color: var(--sb-accent-ink);
  }
</style>
