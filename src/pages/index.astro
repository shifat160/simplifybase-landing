---
import MarketingLayout from '~/layouts/MarketingLayout.astro';
import Band from '~/components/ui/Band.astro';
import Button from '~/components/ui/Button.astro';
import HomeHero from '~/components/sections/HomeHero.astro';
import BandHeader from '~/components/sections/BandHeader.astro';
import ProductMosaic from '~/components/sections/ProductMosaic.astro';
import Stats from '~/components/sections/Stats.astro';
import LogoMarquee from '~/components/sections/LogoMarquee.astro';
import Faq from '~/components/sections/Faq.astro';
import CtaBand from '~/components/sections/CtaBand.astro';
import { SITE, STATS } from '~/site';
import { getPosts, formatDate, postHref } from '~/lib/blog';

/*
  Band rhythm for this page — the thing that makes it scan differently from
  every other page on the site:

    hero → page(portfolio) → ink(numbers) → paper(values) → accent(careers)
         → page(open source) → paper(blog) → page(faq) → ink(CTA)

  The hero is not a Band. It owns a full screen of its own, in quadrants, and
  on desktop it holds that screen for a second one while the panel takes over.
*/

const values = [
  {
    title: 'Bootstrapped',
    body: 'No outside investment and no board to answer to, which means we can build the version of a product that is right rather than the version that is fundable. Growth is funded by customers, so customers are who we answer to.',
  },
  {
    title: 'Small on purpose',
    body: 'We are not trying to grow headcount faster than we can maintain what we have already shipped. That constraint is exactly why the product family is five and not fifty — everything here has an owner who knows it well.',
  },
  {
    title: 'Built to last',
    body: 'Products are versioned, documented and supported for the long run. Nothing in the portfolio is a weekend experiment waiting to be quietly retired when it stops being interesting.',
  },
];

const openSource = [
  { name: 'WordPress', body: 'The platform three of our products are built on.' },
  { name: 'WooCommerce', body: 'The commerce layer SimplifyStock reads from.' },
  { name: 'Astro', body: 'This site, and the docs you are reading.' },
  { name: 'Pagefind', body: 'Static search across every documentation page.' },
];

const integrations = [
  'WooCommerce',
  'Shopify',
  'WordPress',
  'Postmark',
  'Slack',
  'Zapier',
  'Google Sheets',
  'Xero',
  'Amazon SES',
  'Airtable',
];

const faqs = [
  {
    q: 'What exactly is SimplifyBase?',
    a: 'A product studio. We build and maintain a small family of focused tools for commerce and operations teams, rather than one platform that claims to do everything.',
  },
  {
    q: 'Do I have to use all of the products?',
    a: 'No. Each one stands alone and is priced alone. They share an account and a design language, and they talk to each other when it helps, but there is no bundle you have to buy into.',
  },
  {
    q: 'Where does the AI part come in?',
    a: 'Where it earns its place — forecasting demand, ranking risk, spotting the anomaly in a reconciliation. Not as a chat box bolted onto a settings page.',
  },
  {
    q: 'Is my data used to train models?',
    a: 'No. Forecasting models are per-store and built from that store’s own history. Your data is never pooled into a shared model.',
  },
  {
    q: 'Do you take custom work?',
    a: 'Occasionally, when it sharpens a product we already ship. Get in touch and tell us what you are trying to fix.',
  },
];

const posts = (await getPosts()).slice(0, 3);
---

<MarketingLayout title={SITE.name} description={SITE.description}>
  {/* ------------------------------------------------------------ 1. Hero */}
  <HomeHero
    eyebrow={SITE.tagline}
    lines={['Helping small teams', 'compete with the big ones']}
    statement={[
      'SimplifyBase is a product studio.',
      'Five focused tools for commerce,',
      'operations and customer workflows.',
    ]}
    primary={{ label: 'See the portfolio', href: '/product/' }}
    secondary={{ label: 'About the company', href: '/about/' }}
    featured={posts[0]
      ? { label: 'Latest', title: posts[0].data.title, href: postHref(posts[0]) }
      : undefined}
  />

  {/* --------------------------------------------- 2. Do it all / portfolio */}
  {/*
    The wall is wider than the container between 1024 and ~1200 and is meant to
    run off the edge there, as the reference's does. Clipping on the SECTION
    (whose padding box is the full viewport) rather than on the wall itself is
    what keeps that bleed while stopping it from scrolling the page sideways.
  */}
  <Band tone="page" id="portfolio" wide class="overflow-x-clip">
    <header class="reveal mb-10 flex flex-col items-center gap-3 text-center sm:mb-14">
      <h2 class="text-headline">Do it all with SimplifyBase.</h2>
    </header>

    <ProductMosaic />
  </Band>

  {/* --------------------------------------------------------- 3. Numbers */}
  <Band tone="ink" eyebrow="By the numbers" heading="Where we are">
    <Stats items={STATS} />
    <p class="band-muted mt-8 max-w-2xl text-sm leading-relaxed">
      We would rather publish a small number we can stand behind than a large
      one we cannot. These move as the products ship.
    </p>
  </Band>

  {/* ---------------------------------------------------------- 4. Values */}
  <Band
    tone="paper"
    eyebrow="How we work"
    heading="A different kind of software company"
    lede="Three commitments that decide most of the arguments before we have them."
  >
    <div class="grid gap-px border border-line bg-line md:grid-cols-3">
      {
        values.map((v, i) => (
          <div class="reveal flex flex-col gap-3 bg-paper p-6 sm:p-8">
            <span class="font-mono text-xs text-accent-text">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="text-title">{v.title}</h3>
            <p class="text-sm leading-relaxed text-muted">{v.body}</p>
          </div>
        ))
      }
    </div>
  </Band>

  {/* --------------------------------------------------------- 5. Careers */}
  <Band tone="accent" class="relative overflow-hidden">
    <div class="relative z-10 grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-center">
      <div class="flex flex-col items-start gap-5">
        <p class="text-eyebrow">Careers</p>
        <h2 class="text-headline">Make good things, from anywhere</h2>
        <p class="band-muted max-w-lg text-base leading-relaxed">
          We are a small, fully remote team of engineers and operators who have
          mostly worked inside commerce businesses rather than adjacent to them.
          If that sounds like you, we would like to hear from you — even when
          nothing specific is posted.
        </p>
        <Button href="/contact/" variant="primary" size="lg">
          Get in touch
        </Button>
      </div>

      <dl class="grid grid-cols-2 gap-px border border-[var(--band-line)] bg-[var(--band-line)]">
        {
          [
            ['Remote', 'Since day one'],
            ['Async', 'Meetings are the exception'],
            ['Small teams', 'You own what you ship'],
            ['Long horizons', 'No quarterly theatre'],
          ].map(([term, def]) => (
            <div class="bg-[var(--band-bg)] p-5">
              <dt class="band-ink text-sm font-medium">{term}</dt>
              <dd class="band-muted mt-1 text-xs leading-relaxed">{def}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Band>

  {/* ----------------------------------------------------- 6. Open source */}
  <Band
    tone="page"
    eyebrow="Standing on"
    heading="Built on work we did not do"
    lede="Our products exist because of open source. These are the projects we depend on most directly."
  >
    <div class="grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        openSource.map((p) => (
          <div class="reveal flex flex-col gap-2 bg-bg p-6">
            <h3 class="text-title">{p.name}</h3>
            <p class="text-sm leading-relaxed text-muted">{p.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-14">
      <LogoMarquee
        items={integrations}
        label="And working with the tools you already run"
      />
    </div>
  </Band>

  {/* ------------------------------------------------------------ 7. Blog */}
  {
    posts.length > 0 && (
      <Band tone="paper">
        <BandHeader
          heading="Latest from the blog"
          lede="What we are learning while building the products."
          cta={{ label: 'All posts', href: '/blog/' }}
        />

        <ul class="grid gap-px border border-line bg-line md:grid-cols-3">
          {posts.map((post) => (
            <li class="reveal">
              <a
                href={postHref(post)}
                class="flex h-full flex-col gap-3 bg-paper p-6 transition-colors hover:bg-paper-2"
              >
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="font-mono text-xs text-faint"
                >
                  {formatDate(post.data.pubDate)}
                </time>
                <h3 class="text-title">{post.data.title}</h3>
                <p class="text-sm leading-relaxed text-muted">
                  {post.data.description}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </Band>
    )
  }

  {/* ------------------------------------------------------------- 8. FAQ */}
  <Band tone="page" eyebrow="Questions" heading="Before you ask">
    <Faq items={faqs} class="max-w-3xl" />
  </Band>

  <CtaBand
    tone="ink"
    mosaic
    seed="home-cta"
    heading="Start with the one that hurts most"
    lede="SimplifyStock is live and free to install. The rest of the family is in build — tell us which one you need first."
    primary={{ label: 'Install SimplifyStock', href: '/product/simplifystock/' }}
    secondary={{ label: 'Talk to us', href: '/contact/' }}
  />
</MarketingLayout>
