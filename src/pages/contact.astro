---
import MarketingLayout from '~/layouts/MarketingLayout.astro';
import Button from '~/components/ui/Button.astro';
import { SITE, SOCIAL } from '~/site';
import { getProducts } from '~/lib/products';

/*
  There is no form here on purpose.

  The site is static and has no form endpoint. What stood here posted nothing:
  it intercepted submit and rebuilt the fields into a mailto: — so it needed
  JavaScript to do anything at all, needed a configured mail client to finish,
  and with scripts off it swallowed the submit and left the visitor looking at
  their own filled-in form. A form that can fail that quietly is worse than no
  form, because it looks like it worked.

  So: the address, and a set of links that prefill the subject line. Every one
  of them is a plain <a href="mailto:"> that works with no JavaScript at all.

  When there IS a backend to post to, bring the form back with a real
  `action` — not a submit handler.
*/

const products = await getProducts();

/** mailto with the subject filled in. Body deliberately left empty. */
const mailto = (subject: string) =>
  `mailto:${SITE.email}?subject=${encodeURIComponent(subject)}`;

const topics = [
  {
    slug: '',
    label: 'Something else',
    note: 'Partnerships, press, custom work, or a question that fits nowhere above.',
  },
  ...products.map((p) => ({
    slug: p.data.slug,
    label: p.data.name,
    note:
      p.data.status === 'live'
        ? `A question about ${p.data.name}, or a bug you have hit.`
        : `Join the ${p.data.name} waitlist and tell us what you need from it.`,
  })),
];
---

<MarketingLayout
  title="Contact"
  description="Talk to the SimplifyBase team about a product, a problem, or joining a waitlist."
>
  <section class="border-b border-line">
    <div class="container-page pt-16 pb-14 sm:pt-20 sm:pb-16">
      <div class="flex max-w-3xl flex-col items-start gap-5">
        <p class="text-eyebrow">Contact</p>
        <h1 class="text-headline">Tell us what you are trying to fix</h1>
        <p class="max-w-xl text-base leading-relaxed text-muted">
          If we have something for it, we will say so. If we do not, we will say
          that too — and probably tell you what we would use instead.
        </p>
      </div>
    </div>
  </section>

  <div class="container-page py-14 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-16">
      <div class="flex flex-col gap-10">
        <div class="flex flex-col items-start gap-5">
          <h2 class="text-title">Email us</h2>
          <p class="max-w-xl text-base leading-relaxed text-muted">
            One address, read by the people who build the products. Tell us what
            you are running, what is going wrong, and what you have already
            tried.
          </p>
          <Button href={`mailto:${SITE.email}`} variant="primary" size="lg">
            {SITE.email}
          </Button>
        </div>

        <div class="flex flex-col gap-4">
          <h2 class="text-eyebrow">Or start from a subject line</h2>
          <ul class="grid gap-px border border-line bg-line sm:grid-cols-2">
            {
              topics.map((t) => (
                <li data-topic={t.slug}>
                  <a
                    href={mailto(
                      t.slug ? `${t.label} — enquiry` : 'General enquiry',
                    )}
                    class="flex h-full flex-col gap-1.5 bg-bg p-5 transition-colors hover:bg-hover"
                  >
                    <span class="text-sm font-medium text-ink">{t.label}</span>
                    <span class="text-sm leading-relaxed text-muted">
                      {t.note}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <aside class="flex flex-col gap-8">
        <div class="flex flex-col gap-3">
          <h2 class="text-eyebrow">Email</h2>
          <a
            href={`mailto:${SITE.email}`}
            class="text-sm text-body transition-colors hover:text-ink"
            >{SITE.email}</a
          >
        </div>

        {
          SOCIAL.length > 0 && (
            <div class="flex flex-col gap-3">
              <h2 class="text-eyebrow">Elsewhere</h2>
              <ul class="flex flex-col gap-2">
                {SOCIAL.map((s) => (
                  <li>
                    <a
                      href={s.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-sm text-body transition-colors hover:text-ink"
                    >
                      {s.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="flex flex-col gap-3">
          <h2 class="text-eyebrow">Support</h2>
          <p class="text-base leading-relaxed text-muted">
            Already using a product? Check the docs first — <a
              href="/product/simplifystock/docs/troubleshooting/"
              class="text-accent-text underline underline-offset-2 hover:opacity-80"
              >Troubleshooting</a
            > covers the failures we see most.
          </p>
        </div>
      </aside>
    </div>
  </div>
</MarketingLayout>

{/*
  Enhancement only. Product pages and docs link here as
  /contact/?product=<slug>, so mark that topic when the visitor arrives from
  one. Without JavaScript the list is simply unmarked — every link still works.

  is:inline is implied by define:vars; stated so nobody adds a TypeScript-only
  construct below expecting it to compile.
*/}
<script is:inline>
  const wanted = new URLSearchParams(location.search).get('product');
  const target =
    wanted && document.querySelector(`[data-topic="${CSS.escape(wanted)}"]`);

  if (target) {
    target.firstElementChild?.classList.add(
      'bg-accent-soft!',
      'ring-1',
      'ring-accent',
      'ring-inset',
    );
    target.scrollIntoView({ block: 'center', behavior: 'smooth' });
  }
</script>
