---
import MarketingLayout from '~/layouts/MarketingLayout.astro';
import Band from '~/components/ui/Band.astro';
import ProductGrid from '~/components/sections/ProductGrid.astro';
import CtaBand from '~/components/sections/CtaBand.astro';
import { getProducts, STATUS_LABEL } from '~/lib/products';

const products = await getProducts();
const live = products.filter((p) => p.data.status === 'live').length;

// Spelled out rather than a numeral — "1 of the five" reads like a typo next
// to the word "five" in the same sentence.
const WORDS = ['None', 'One', 'Two', 'Three', 'Four', 'Five'];
const liveWord = WORDS[live] ?? String(live);
---

<MarketingLayout
  title="Products"
  description="The SimplifyBase product family — focused tools for commerce, operations and customer workflows."
>
  <section class="border-b border-line">
    <div class="container-page pt-16 pb-14 sm:pt-24 sm:pb-20">
      <div class="flex max-w-3xl flex-col items-start gap-6">
        <p class="text-eyebrow">The family</p>
        <h1 class="text-display">Five products, one standard</h1>
        <p class="max-w-xl text-lede text-muted">
          Each one solves a single problem completely, is priced on its own, and
          is documented like we expect you to read it. {liveWord} of the five {
            live === 1 ? 'is' : 'are'
          } shipping today; the rest are in build.
        </p>
      </div>
    </div>
  </section>

  <Band>
    <ProductGrid fill={false} />
  </Band>

  <Band
    divider
    eyebrow="At a glance"
    heading="Where each one is"
  >
    <div class="overflow-x-auto">
      <table class="w-full min-w-[36rem] border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-line">
            <th class="text-eyebrow pb-3 font-normal">Product</th>
            <th class="text-eyebrow pb-3 font-normal">Does</th>
            <th class="text-eyebrow pb-3 font-normal">Status</th>
          </tr>
        </thead>
        <tbody>
          {
            products.map((p) => (
              <tr class="border-b border-line last:border-0">
                <td class="py-4 pe-6 align-top whitespace-nowrap">
                  <a
                    href={`/product/${p.data.slug}/`}
                    class="text-ink transition-colors hover:text-accent-text"
                  >
                    {p.data.name}
                  </a>
                </td>
                <td class="py-4 pe-6 align-top text-muted">{p.data.tagline}</td>
                <td class="py-4 align-top font-mono text-xs whitespace-nowrap text-muted">
                  {STATUS_LABEL[p.data.status]}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Band>

  <CtaBand
    heading="Not sure which one you need?"
    lede="Tell us what is taking up your Tuesday morning and we will tell you honestly whether we have something for it."
    primary={{ label: 'Talk to us', href: '/contact/' }}
    secondary={{ label: 'Read the blog', href: '/blog/' }}
  />
</MarketingLayout>
