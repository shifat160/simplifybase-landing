---
import type { GetStaticPaths } from 'astro';
import MarketingLayout from '~/layouts/MarketingLayout.astro';
import Band from '~/components/ui/Band.astro';
import Button from '~/components/ui/Button.astro';
import Badge from '~/components/ui/Badge.astro';
import Mosaic from '~/components/ui/Mosaic.astro';
import AppWindow from '~/components/ui/AppWindow.astro';
import BandHeader from '~/components/sections/BandHeader.astro';
import ReorderMock from '~/components/sections/ReorderMock.astro';
import LogoMarquee from '~/components/sections/LogoMarquee.astro';
import Pricing from '~/components/sections/Pricing.astro';
import Faq from '~/components/sections/Faq.astro';
import CtaBand from '~/components/sections/CtaBand.astro';
import ProductGrid from '~/components/sections/ProductGrid.astro';
import { getProducts, productDocsHref, STATUS_LABEL } from '~/lib/products';
import { getDocumentedProducts } from '~/lib/docs';
import { rhythmFor } from '~/lib/rhythm';

export const getStaticPaths = (async () => {
  const products = await getProducts();
  return products.map((product, i) => ({
    params: { product: product.data.slug },
    // The index, not the slug, drives the rhythm — see lib/rhythm.ts.
    props: { product, rhythm: rhythmFor(i) },
  }));
}) satisfies GetStaticPaths;

const { product, rhythm } = Astro.props;
const p = product.data;

const documented = await getDocumentedProducts();
const hasDocs = documented.has(p.slug);

// Only SimplifyStock has a mockup worth showing. The rest are unbuilt, and a
// fake screenshot of software that does not exist would be a lie.
const hasMock = p.slug === 'simplifystock';

/*
  The feature grid draws its gaps as background, so an empty trailing cell
  reads as a broken tile rather than as whitespace. Count the cells a `wide`
  feature occupies, and if the total is odd, let the last feature span the row
  as well.
*/
const featureCells = p.features.reduce((n, f) => n + (f.wide ? 2 : 1), 0);
const stretchLastFeature = featureCells % 2 !== 0;
---

<MarketingLayout
  title={`${p.name} — ${p.tagline}`}
  description={p.summary}
  brandSuffix={false}
  image={`/og/${p.slug}.png`}
  accent={p.accent}
>
  {/* ---------------------------------------------------------------- Hero */}
  <Band tone={rhythm.hero} size="loose" class={rhythm.heroMosaic ? 'pb-0!' : ''}>
    <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-center">
      <div class="flex max-w-2xl flex-col items-start gap-5">
        <div class="flex flex-wrap items-center gap-3">
          <Badge tone={p.status}>{STATUS_LABEL[p.status]}</Badge>
          {p.hero.eyebrow && <p class="text-eyebrow">{p.hero.eyebrow}</p>}
        </div>

        <h1 class="text-display">{p.hero.headline}</h1>

        <p class="band-muted max-w-xl text-lg leading-relaxed">{p.hero.sub}</p>

        <div class="mt-1 flex flex-wrap gap-3">
          {
            p.hero.ctas.map((c, i) => (
              <Button
                href={c.href}
                variant={i === 0 ? 'primary' : 'secondary'}
                size="lg"
              >
                {c.label}
              </Button>
            ))
          }
          {
            hasDocs && !p.hero.ctas.some((c) => c.href.includes('/docs')) && (
              <Button href={productDocsHref(p.slug)} variant="ghost" size="lg">
                Documentation →
              </Button>
            )
          }
        </div>
      </div>

      {
        hasMock ? (
          <AppWindow class="reveal">
            <ReorderMock />
          </AppWindow>
        ) : (
          <div class="reveal border border-[var(--band-line)] p-6 sm:p-8">
            <p class="text-eyebrow">In build</p>
            <p class="band-body mt-3 text-sm leading-relaxed">
              {p.name} is in active design. Join the waitlist and you will get
              early builds — and a say in what ships first.
            </p>
          </div>
        )
      }
    </div>
  </Band>

  {
    rhythm.heroMosaic && (
      <div class={`band tone-${rhythm.hero} pt-12 sm:pt-16`}>
        <Mosaic seed={`${p.slug}-hero`} cols={44} rows={6} fade="right" />
      </div>
    )
  }

  {/* ------------------------------------------------------------ Features */}
  {
    p.features.length > 0 && (
      <Band tone={rhythm.features}>
        <BandHeader
          heading={`What ${p.name} does`}
          lede={p.summary}
          cta={hasDocs ? { label: 'Read the docs', href: productDocsHref(p.slug) } : undefined}
        />

        <div class="grid gap-px border border-[var(--band-line)] bg-[var(--band-line)] md:grid-cols-2">
          {p.features.map((f, i) => (
            <div
              class:list={[
                'reveal flex flex-col gap-3 bg-[var(--band-bg)] p-6 sm:p-8',
                (f.wide ||
                  (stretchLastFeature && i === p.features.length - 1)) &&
                  'md:col-span-2',
              ]}
            >
              <h3 class="text-title band-ink">{f.title}</h3>
              <p class="band-muted max-w-2xl text-sm leading-relaxed">
                {f.body}
              </p>
            </div>
          ))}
        </div>
      </Band>
    )
  }

  {/* --------------------------------------------------------- How it works */}
  {
    p.howItWorks.length > 0 && (
      <Band
        tone={rhythm.how}
        eyebrow="How it works"
        heading="Three steps, then it runs"
      >
        <ol class="grid gap-px border border-[var(--band-line)] bg-[var(--band-line)] sm:grid-cols-3">
          {p.howItWorks.map((step, i) => (
            <li class="reveal flex flex-col gap-3 bg-[var(--band-bg)] p-6 sm:p-8">
              {/* band-muted, not band-ink at 60%: on an accent band the
                  latter lands at 3.3:1, and which products get an accent band
                  here depends on rhythmFor(i) — so it fails on whichever
                  product happens to be third. */}
              <span class="band-muted font-mono text-xs">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="text-title band-ink">{step.title}</h3>
              <p class="band-muted text-sm leading-relaxed">{step.body}</p>
            </li>
          ))}
        </ol>
      </Band>
    )
  }

  {/* -------------------------------------------------------- Integrations */}
  {
    p.integrations.length > 0 && (
      <Band tone={rhythm.integrations} size="tight">
        <LogoMarquee items={p.integrations} label={`${p.name} works with`} />
      </Band>
    )
  }

  {/* ------------------------------------------------------------- Pricing */}
  {
    p.pricing.length > 0 && (
      <Band
        id="pricing"
        tone={rhythm.pricing}
        eyebrow="Pricing"
        heading="Priced on its own"
        lede="No bundle to buy into. Cancel and you drop to the free plan rather than losing your data."
      >
        <Pricing tiers={p.pricing} />
      </Band>
    )
  }

  {/* ----------------------------------------------------------------- FAQ */}
  {
    p.faqs.length > 0 && (
      <Band tone={rhythm.faq} eyebrow="Questions" heading={`About ${p.name}`}>
        <Faq items={p.faqs} class="max-w-3xl" />
      </Band>
    )
  }

  {/* ---------------------------------------------------------- The family */}
  <Band tone={rhythm.family}>
    <BandHeader
      heading="The rest of the family"
      lede="Each one stands alone. Use one, use all five, or use one and ignore the others entirely."
      cta={{ label: 'All products', href: '/product/' }}
    />
    <ProductGrid exclude={p.slug} columns={2} />
  </Band>

  <CtaBand
    tone={rhythm.cta}
    mosaic={rhythm.cta === 'ink'}
    seed={`${p.slug}-cta`}
    heading={p.status === 'live'
      ? `Get started with ${p.name}`
      : `Be first to use ${p.name}`}
    lede={p.summary}
    primary={p.hero.ctas[0]
      ? { label: p.hero.ctas[0].label, href: p.hero.ctas[0].href }
      : { label: 'Talk to us', href: '/contact/' }}
    secondary={hasDocs
      ? { label: 'Read the docs', href: productDocsHref(p.slug) }
      : { label: 'Talk to us', href: '/contact/' }}
  />
</MarketingLayout>
