---
import Logo from '~/components/ui/Logo.astro';
import { SITE, SOCIAL, FOOTER_COLUMNS } from '~/site';
import { getProducts, productHref } from '~/lib/products';

const products = await getProducts();
const year = new Date().getFullYear();
---

{/* Always paper-toned, so it reads as the end of the page rather than as one
    more band in whatever rhythm the page above it happens to use. */}
<footer class="band tone-paper border-t border-line">
  <div class="container-wide py-14 sm:py-16">
    <div class="grid gap-10 md:grid-cols-[1.4fr_repeat(4,1fr)] md:gap-8">
      <div class="flex flex-col gap-4">
        <a href="/" aria-label="SimplifyBase home"><Logo /></a>
        <p class="max-w-xs text-sm leading-relaxed text-muted">
          {SITE.promise}
        </p>
        <ul class="mt-1 flex gap-4">
          {
            SOCIAL.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-muted transition-colors hover:text-ink"
                >
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex flex-col gap-4">
        <h2 class="text-eyebrow">Products</h2>
        <ul class="flex flex-col gap-2.5">
          {
            products.map((p) => (
              <li>
                <a
                  href={productHref(p.data.slug)}
                  class="text-sm text-muted transition-colors hover:text-ink"
                >
                  {p.data.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        FOOTER_COLUMNS.map((col) => (
          <div class="flex flex-col gap-4">
            <h2 class="text-eyebrow">{col.title}</h2>
            <ul class="flex flex-col gap-2.5">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-muted transition-colors hover:text-ink"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-14 flex flex-col gap-3 border-t border-line pt-7 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="font-mono text-xs text-faint">
        © {year} {SITE.name}. {SITE.tagline}.
      </p>
      <a
        href={`mailto:${SITE.email}`}
        class="font-mono text-xs text-faint transition-colors hover:text-ink"
        >{SITE.email}</a
      >
    </div>
  </div>
</footer>
