---
import Logo from '~/components/ui/Logo.astro';
import Badge from '~/components/ui/Badge.astro';
import ThemeToggle from '~/components/ui/ThemeToggle.astro';
import { NAV } from '~/site';
import { getProducts, productHref, STATUS_LABEL } from '~/lib/products';

const products = await getProducts();
const path = Astro.url.pathname;

// A nav item is current when the path sits underneath it. The home link is
// excluded from the prefix rule or it would match everything.
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

/*
  The bar is a row of CELLS divided by hairlines, edge to edge — no container,
  no gutter, no rounded corners. The dividers are the design: they turn the nav
  into the same ruled grid the page bands use, and they are why every cell owns
  its own padding rather than the row using `gap`.

  Hover changes the BACKGROUND ONLY. Labels sit at full ink strength at rest
  and stay there — in a divided grid the hairlines already tell you which cell
  the pointer is in, so darkening the text as well makes the whole bar twitch
  as you cross it. The fill is a barely-there off-white for the same reason.
*/
const cell =
  'flex items-center border-r border-line px-4 lg:px-5 text-sm text-ink transition-colors duration-150 hover:bg-hover';
---

{/*
  Always page-toned, never inherited from the band beneath it. A sticky bar
  that changed colour as bands scrolled under it would be unreadable at every
  boundary.
*/}
<header
  class="band tone-page sticky top-0 z-40 border-b border-line bg-bg/95 backdrop-blur-xl"
  data-nav
>
  <nav
    class="flex h-[var(--sb-nav-h)] items-stretch"
    aria-label="Main"
  >
    {/* The logo's divider is suppressed below md: with the nav cells hidden,
        it would sit a few pixels from the actions cluster's own divider and
        read as a double rule with nothing between them. */}
    <a
      href="/"
      class={`${cell} shrink-0 border-r-0 md:border-r`}
      aria-label="SimplifyBase home"
    >
      <Logo />
    </a>

    <!-- Desktop cells -->
    <ul class="hidden items-stretch md:flex">
      {
        NAV.map((item) =>
          item.dropdown ? (
            <li class="flex items-stretch">
              <button
                type="button"
                data-dropdown-trigger
                aria-expanded="false"
                aria-controls="mega-products"
                class:list={[
                  cell,
                  // The open state is explicit, not left to a lingering hover:
                  // the cell must stay lit while the panel below it is down,
                  // including after the pointer has moved into the panel.
                  'gap-1.5 aria-expanded:bg-hover',
                ]}
              >
                {item.label}
                <svg
                  viewBox="0 0 12 12"
                  fill="none"
                  aria-hidden="true"
                  class="size-3 transition-transform duration-200 [[aria-expanded=true]_&]:rotate-180"
                >
                  <path
                    d="m3 4.5 3 3 3-3"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
            </li>
          ) : (
            <li class="flex items-stretch">
              {/* The current page is marked with a rule under its cell rather
                  than a colour change, since colour is already spoken for by
                  hover. */}
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[
                  cell,
                  'relative',
                  isCurrent(item.href) &&
                    'after:absolute after:inset-x-0 after:bottom-0 after:h-px after:bg-ink',
                ]}
              >
                {item.label}
              </a>
            </li>
          ),
        )
      }
    </ul>

    {/* The empty run between the nav and the actions — deliberately undivided,
        so the two clusters read as separate groups rather than one long rule. */}
    <div class="flex-1"></div>

    <div class="flex items-stretch">
      <div class="flex items-stretch border-l border-line">
        <ThemeToggle />
      </div>

      {/*
        Runs to the viewport edge, full height. The one solid block in the bar,
        and the only thing in it that is not a hairline.

        On hover the arrow swaps sides: the resting one slides out to the right
        while a second slides in from the left, both clipped by overflow-hidden.
        Two arrows rather than one moving arrow — a single element cannot be in
        two places, and fading one out reads as a glitch at this speed.
      */}
      <a
        href="/contact/"
        class="group relative flex items-center gap-2 overflow-hidden bg-ink px-5 text-sm font-medium text-bg transition-colors duration-150 hover:bg-ink-hover lg:px-6"
      >
        <span
          class="absolute left-4 -translate-x-4 opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100 lg:left-5"
          aria-hidden="true">→</span
        >
        <span
          class="transition-transform duration-200 group-hover:translate-x-3"
        >
          Talk to us
        </span>
        <span
          class="transition-all duration-200 group-hover:translate-x-4 group-hover:opacity-0"
          aria-hidden="true">→</span
        >
      </a>

      <button
        type="button"
        data-mobile-trigger
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid w-14 place-items-center border-l border-line text-ink transition-colors duration-150 hover:bg-hover md:hidden"
        aria-label="Open menu"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
          class="size-5"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  {/* ------------------------------------------------------- Products mega-menu
      Full-width rather than anchored under its trigger: at this cell width an
      anchored panel would be a narrow column floating under one word, which
      fights the edge-to-edge bar above it. */}
  <div
    id="mega-products"
    hidden
    class="border-t border-line bg-bg"
    data-dropdown-panel
  >
    <ul class="grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        products.map((p) => (
          <li>
            <a
              href={productHref(p.data.slug)}
              class="group flex h-full flex-col bg-bg p-5 transition-colors hover:bg-[color-mix(in_oklab,var(--sb-accent)_7%,var(--sb-bg))]"
              style={p.data.accent ? `--sb-accent:${p.data.accent}` : undefined}
            >
              <span
                class="mb-4 block h-1 w-7 rounded-full"
                style="background-color:var(--sb-accent)"
              />
              <span class="flex items-center gap-2">
                <span class="text-sm font-medium text-ink">{p.data.name}</span>
                <Badge tone={p.data.status}>
                  {STATUS_LABEL[p.data.status]}
                </Badge>
              </span>
              <span class="mt-1.5 block text-[0.8125rem] leading-snug text-muted">
                {p.data.tagline}
              </span>
            </a>
          </li>
        ))
      }

      <li>
        <a
          href="/product/"
          class="group flex h-full flex-col justify-between gap-4 bg-paper p-5 transition-colors hover:bg-paper-2"
        >
          <span class="text-eyebrow">The full family</span>
          <span class="text-sm text-ink">
            Compare every product
            <span
              class="ms-1 inline-block transition-transform duration-200 group-hover:translate-x-0.5"
              aria-hidden="true">→</span
            >
          </span>
        </a>
      </li>
    </ul>
  </div>

  <!-- Mobile -->
  <div
    id="mobile-menu"
    hidden
    class="max-h-[calc(100dvh-var(--sb-nav-h))] overflow-y-auto border-t border-line bg-bg md:hidden"
  >
    <ul class="grid gap-px bg-line">
      {
        products.map((p) => (
          <li>
            <a
              href={productHref(p.data.slug)}
              class="flex items-center justify-between gap-3 bg-bg px-4 py-3.5"
              style={p.data.accent ? `--sb-accent:${p.data.accent}` : undefined}
            >
              <span class="flex items-center gap-3">
                <span
                  class="size-2 rounded-full"
                  style="background-color:var(--sb-accent)"
                />
                <span class="text-sm text-ink">{p.data.name}</span>
              </span>
              <Badge tone={p.data.status}>{STATUS_LABEL[p.data.status]}</Badge>
            </a>
          </li>
        ))
      }
      {
        [
          { label: 'All products', href: '/product/' },
          ...NAV.filter((i) => !i.dropdown),
        ].map((i) => (
          <li>
            <a href={i.href} class="block bg-bg px-4 py-3.5 text-sm text-ink transition-colors hover:bg-hover">
              {i.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  // Only one panel can be open at a time — the mega-menu and the mobile menu
  // both live inside the sticky header, and two open at once would stack.
  const header = document.querySelector<HTMLElement>('[data-nav]');
  const trigger = document.querySelector<HTMLButtonElement>(
    '[data-dropdown-trigger]',
  );
  const panel = document.querySelector<HTMLElement>('[data-dropdown-panel]');
  const mobileTrigger = document.querySelector<HTMLButtonElement>(
    '[data-mobile-trigger]',
  );
  const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');

  const setPanel = (
    btn: HTMLButtonElement | null,
    el: HTMLElement | null,
    open: boolean,
  ) => {
    if (!btn || !el) return;
    btn.setAttribute('aria-expanded', String(open));
    el.hidden = !open;
  };

  const closeAll = () => {
    setPanel(trigger, panel, false);
    setPanel(mobileTrigger, mobileMenu, false);
    mobileTrigger?.setAttribute('aria-label', 'Open menu');
  };

  /*
    Opens on hover, like the reference — but hover is an enhancement layered
    over click, never a replacement for it. Click still toggles, so touch and
    hybrid laptops work; focus opens it, so keyboards do.

    `(hover: hover)` gates the pointer behaviour: on a touchscreen the browser
    fires a synthetic mouseenter immediately before the click, which would open
    the panel and then have the click close it again.
  */
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');

  trigger?.addEventListener('click', () => {
    const open = trigger.getAttribute('aria-expanded') !== 'true';
    closeAll();
    setPanel(trigger, panel, open);
  });

  trigger?.addEventListener('focus', () => {
    if (trigger.getAttribute('aria-expanded') !== 'true') {
      closeAll();
      setPanel(trigger, panel, true);
    }
  });

  trigger?.addEventListener('pointerenter', (e) => {
    if (e.pointerType !== 'mouse' || !canHover.matches) return;
    closeAll();
    setPanel(trigger, panel, true);
  });

  /*
    Closing is driven by leaving the HEADER, not the trigger. The panel sits
    below the trigger, so leaving the trigger downwards — the only way to reach
    the panel — must not close it. The header wraps both, so one listener on it
    covers the whole hover target.

    The delay covers the diagonal: moving from the trigger to a panel item on
    the far right briefly exits the header's box on some layouts.
  */
  let closeTimer: ReturnType<typeof setTimeout>;

  header?.addEventListener('pointerleave', (e) => {
    if (e.pointerType !== 'mouse' || !canHover.matches) return;
    clearTimeout(closeTimer);
    closeTimer = setTimeout(() => {
      // Never yank a panel out from under someone typing or tabbing in it.
      if (!header.contains(document.activeElement)) closeAll();
    }, 180);
  });

  header?.addEventListener('pointerenter', () => clearTimeout(closeTimer));

  mobileTrigger?.addEventListener('click', () => {
    const open = mobileTrigger.getAttribute('aria-expanded') !== 'true';
    closeAll();
    setPanel(mobileTrigger, mobileMenu, open);
    mobileTrigger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });

  document.addEventListener('click', (e) => {
    if (!header?.contains(e.target as Node)) closeAll();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const wasOpen = trigger?.getAttribute('aria-expanded') === 'true';
    closeAll();
    if (wasOpen) trigger?.focus();
  });

  header?.addEventListener('focusout', (e) => {
    if (!header.contains(e.relatedTarget as Node)) closeAll();
  });
</script>
