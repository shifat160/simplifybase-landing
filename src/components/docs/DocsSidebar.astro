---
import { docHref, type SidebarGroup } from '~/lib/docs';

interface Props {
  groups: SidebarGroup[];
  /** Entry id of the page being viewed, for the current marker. */
  currentId: string;
}

const { groups, currentId } = Astro.props;
---

<nav aria-label="Documentation" class="flex flex-col gap-7">
  {
    groups.map((group) => (
      <div class="flex flex-col gap-1">
        {group.title && (
          <h2 class="text-eyebrow mb-2 px-3">{group.title}</h2>
        )}
        <ul class="flex flex-col gap-0.5">
          {group.items.map((doc) => {
            const current = doc.id === currentId;
            return (
              <li>
                <a
                  href={docHref(doc)}
                  aria-current={current ? 'page' : undefined}
                  class:list={[
                    'block rounded-md px-3 py-1.5 text-[0.8125rem] leading-relaxed transition-colors',
                    current
                      ? 'bg-accent-soft font-medium text-accent-text'
                      : 'text-muted hover:bg-surface hover:text-ink',
                  ]}
                >
                  {doc.data.sidebarLabel ?? doc.data.title}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</nav>
