---
/**
 * Stand-in for a SimplifyStock screenshot: a reorder list with days-of-cover
 * bars. Hand-built rather than a PNG so it stays sharp, follows the band it
 * sits in, and costs nothing to load. Replace with a real capture when the app
 * ships.
 *
 * Rendered inside AppWindow, which is already aria-hidden.
 */
const rows = [
  { sku: 'CFE-1KG-DRK', name: 'Dark roast, 1kg', cover: 4, qty: 240, risk: 'high' },
  { sku: 'CFE-250-MED', name: 'Medium roast, 250g', cover: 9, qty: 120, risk: 'high' },
  { sku: 'FLT-V60-02', name: 'V60 filters, 100pk', cover: 21, qty: 60, risk: 'watch' },
  { sku: 'MUG-CER-WHT', name: 'Ceramic mug, white', cover: 48, qty: 0, risk: 'ok' },
  { sku: 'GRN-HND-01', name: 'Hand grinder', cover: 63, qty: 0, risk: 'ok' },
];

// 60 days of cover fills the bar; anything beyond is simply "plenty".
const barWidth = (cover: number) => Math.min(100, (cover / 60) * 100);

const riskLabel = { high: 'Reorder', watch: 'Watch', ok: 'OK' } as const;
---

<div class="flex flex-col gap-3">
  <div class="flex items-baseline justify-between">
    <p class="band-ink text-sm font-medium">Reorder list</p>
    <p class="text-caption">5 of 312</p>
  </div>

  <div class="flex flex-col">
    {
      rows.map((row) => (
        <div class="grid grid-cols-[1fr_auto] items-center gap-3 border-t border-[var(--band-line)] py-2.5 first:border-0 sm:grid-cols-[1.5fr_1fr_auto]">
          <span class="min-w-0">
            <span class="band-ink block truncate text-[0.8125rem]">
              {row.name}
            </span>
            <span class="text-caption block">{row.sku}</span>
          </span>

          <span class="hidden items-center gap-2 sm:flex">
            <span class="h-1 w-full max-w-14 overflow-hidden rounded-full bg-[var(--band-line)]">
              <span
                class="block h-full rounded-full"
                style={`width:${barWidth(row.cover)}%;background-color:${
                  row.risk === 'high'
                    ? 'var(--sb-accent)'
                    : 'var(--band-muted)'
                }`}
              />
            </span>
            <span class="band-muted font-mono text-[0.6875rem]">
              {row.cover}d
            </span>
          </span>

          <span
            class:list={[
              'text-right font-mono text-[0.625rem] tracking-wide uppercase',
              row.risk === 'high' ? 'text-accent-text' : 'band-muted',
            ]}
          >
            {riskLabel[row.risk as keyof typeof riskLabel]}
          </span>
        </div>
      ))
    }
  </div>

  <div class="flex items-center justify-between border-t border-[var(--band-line)] pt-3">
    <p class="text-caption">Updated 12 min ago</p>
    <span class="rounded-md bg-accent px-2.5 py-1 text-[0.6875rem] font-medium text-accent-ink">
      Create purchase order
    </span>
  </div>
</div>
