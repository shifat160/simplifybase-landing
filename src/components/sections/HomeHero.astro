---
import Mosaic from '~/components/ui/Mosaic.astro';
import Button from '~/components/ui/Button.astro';
import ProductIcon from '~/components/ui/ProductIcon.astro';
import { getProducts } from '~/lib/products';

/**
 * The home hero, built to the same plan as mistral.ai's.
 *
 * LAYOUT — one bordered frame, exactly one screen tall, cut into quadrants:
 *
 *   ┌──────────────────────────┬──────────────┐
 *   │ eyebrow                  │   glyphs     │ 60%
 *   │ GIANT TITLE, bottom-set  │  statement   │
 *   ├──────────────────────────┼──────────────┤
 *   │ mosaic (their lottie)    │  scroll cue  │ 40%
 *   │                          │  latest post │
 *   └──────────────────────────┴──────────────┘
 *          70%                       30%
 *
 * The hairlines are drawn by the LEFT cells (border-r) and the BOTTOM cells
 * (border-t) so both rules sit just outside the panel's clip region. Put them
 * on the panel side instead and the expansion below eats them a frame early.
 *
 * MOTION — two independent systems:
 *
 * 1. Intro, on load. The title is split to characters at build time; each line
 *    is a mask that unrolls while its characters rise into it, with a
 *    per-character delay drawn from a seeded RNG (mistral randomises the same
 *    stagger at runtime with GSAP SplitText). Deterministic here so the markup
 *    is stable between builds.
 *
 * 2. Scroll, desktop only. The frame is pinned for one screen while the panel
 *    grows out of its quadrant to fill the frame and its statement travels to
 *    the centre; everything else clears out of the way. Pure CSS scroll-driven
 *    animation — no library, and gated behind @supports, so a browser without
 *    it (Firefox today) gets the static one-screen hero and no dead scroll.
 *
 * Only transform, opacity and clip-path animate. Nothing here lays out again.
 */
interface Props {
  eyebrow?: string;
  /** One entry per rendered line. Lines do not wrap on desktop. */
  lines: string[];
  /** The supporting statement, likewise pre-broken. */
  statement: string[];
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  /** The card in the bottom-right cell — their "featured news" slot. */
  featured?: { label: string; title: string; href: string };
}

const { eyebrow, lines, statement, primary, secondary, featured } = Astro.props;

// Three product glyphs ride above the statement, as their three pictograms do.
const glyphs = (await getProducts()).slice(0, 3);

/*
  Seeded LCG — same idea as Mosaic's, and for the same reason: a build-time
  Math.random would rewrite every character's delay on every build and make a
  visual regression impossible to spot in a diff.
*/
let seed = 0x9e3779b9;
const rand = () => {
  seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
  return seed / 4294967296;
};

const LINE_STEP = 700; // ms between lines — their 0.7s line stagger
const CHAR_STEP = 5; // ms per character, multiplied by 1–5 at random

/*
  Split to words, then to characters. The word is the unit that carries the
  clipping mask — mistral masks whole lines, which only holds while a line
  never wraps. Masking per word keeps the effect intact on a phone, where ours
  do wrap. The character index runs across the whole line so the stagger reads
  as one sweep rather than restarting at every word.
*/
const title = lines.map((text, li) => {
  const words = text.split(' ');
  let ci = 0;

  return {
    delay: li * LINE_STEP,
    words: words.map((word, wi) => ({
      // The space rides along inside the mask; a bare text node between two
      // masked words collapses at a line break.
      chars: [...(wi < words.length - 1 ? `${word} ` : word)].map((ch) => ({
        ch,
        delay: li * LINE_STEP + ci++ * (1 + Math.floor(rand() * 5)) * CHAR_STEP,
      })),
    })),
  };
});

// The intro should be finished before the statement and the furniture arrive.
const tail = (lines.length - 1) * LINE_STEP + 900;
---

<section class="hero band tone-page" aria-label="Introduction">
  <div class="hero-shell">
    <div class="hero-frame">
      <div class="hero-grid">
        {/* ---------------------------------------------- top left: title */}
        <div class="hero-cell hero-title-cell">
          {eyebrow && <p class="text-eyebrow hero-eyebrow">{eyebrow}</p>}

          <h1 class="hero-title">
            {
              title.map((line) => (
                <span class="hero-line" style={`--d:${line.delay}ms`}>
                  {line.words.map((word) => (
                    <span class="hero-word">
                      {word.chars.map((c) => (
                        <span class="hero-char" style={`--d:${c.delay}ms`}>
                          {c.ch}
                        </span>
                      ))}
                    </span>
                  ))}
                </span>
              ))
            }
          </h1>
        </div>

        {/* ------------------------------------------- bottom left: mosaic */}
        <div class="hero-cell hero-media">
          <Mosaic seed="simplifybase-home" cols={40} rows={12} fade="right" />
        </div>

        {/* --------------------------------- bottom right: cue + latest post */}
        <div class="hero-cell hero-aside">
          {/*
            The scroll animation moves these two wrappers; the intro animation
            moves what is inside them. One element cannot carry both, because
            the second animation-name would replace the first.
          */}
          <div class="hero-aside-top">
            <span
              class="scroll-cue hero-arrows flex flex-col items-start gap-1 text-muted"
              aria-hidden="true"
              style={`--start:${tail + 200}ms`}
            >
              {
                [0, 1, 2].map((i) => (
                  <svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    class="size-4"
                    style={`--i:${i}`}
                  >
                    <path d="M8 3v9m0 0 3.5-3.5M8 12 4.5 8.5" />
                  </svg>
                ))
              }
            </span>
          </div>

          {
            featured && (
              <div class="hero-aside-bottom">
                <a href={featured.href} class="hero-card" style={`--start:${tail + 300}ms`}>
                  <p class="text-caption">{featured.label}</p>
                  <p class="text-title mt-2 line-clamp-2">{featured.title}</p>
                  <span class="mt-3 inline-flex items-center gap-1.5 text-sm text-muted">
                    Read it
                    <span class="hero-card-arrow" aria-hidden="true">
                      →
                    </span>
                  </span>
                </a>
              </div>
            )
          }
        </div>

        {/* ------------------------------------------------------ the panel */}
        <div class="hero-panel band tone-paper">
          <div class="hero-panel-body" style={`--start:${tail}ms`}>
            <div class="hero-glyphs" aria-hidden="true">
              {
                glyphs.map((p, i) => (
                  <span class="hero-glyph" style={`--i:${i};--sb-accent:${p.data.accent}`}>
                    <span class="hero-glyph-inner">
                      <ProductIcon slug={p.data.slug} class="size-6" />
                    </span>
                  </span>
                ))
              }
            </div>

            <p class="hero-statement">
              {statement.map((s) => <span>{s}</span>)}
            </p>

            {
              (primary || secondary) && (
                <div class="hero-ctas">
                  {primary && (
                    <Button href={primary.href} variant="primary" size="lg">
                      {primary.label}
                    </Button>
                  )}
                  {secondary && (
                    <Button href={secondary.href} variant="secondary" size="lg">
                      {secondary.label}
                    </Button>
                  )}
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ----------------------------------------------------------------- frame */
  .hero-shell {
    position: relative;
  }

  .hero-frame {
    width: 100%;
    max-width: calc(var(--sb-container-wide) + var(--sb-gutter) * 2);
    margin-inline: auto;
    border-inline: 1px solid var(--sb-line);
    border-bottom: 1px solid var(--sb-line);
    overflow: hidden;
  }

  .hero-grid {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .hero-cell {
    position: relative;
    padding: 1.75rem var(--sb-gutter);
  }

  /* ------------------------------------------------------------ the title */
  .hero-eyebrow {
    margin-bottom: 1.5rem;
  }

  .hero-title {
    /*
      Deliberately larger than `text-display`. The restraint documented on that
      utility is about headings fighting a saturated band; this one sits on the
      page canvas and its whole job is to fill the column, as theirs does.

      Below the desktop layout the lines wrap, so this is a plain viewport
      clamp. On desktop they must not wrap, and the size is derived from the
      column instead — see the cqw rule further down.
    */
    font-size: clamp(2rem, 7.6vw, 3rem);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 500;
  }

  .hero-line {
    display: block;
  }

  /* The clipping window each character rises into. 1.16em rather than 1em so
     descenders are not shaved off once the line has settled. */
  .hero-word {
    display: inline-block;
    vertical-align: bottom;
    block-size: 1.16em;
    overflow: hidden;
  }

  .hero-char {
    display: inline-block;
    white-space: pre;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-char {
      animation: hero-char-rise 1s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: var(--d, 0ms);
    }
  }

  @keyframes hero-char-rise {
    from {
      transform: translateY(105%);
    }
    to {
      transform: none;
    }
  }

  /* ------------------------------------------------------------- the panel */
  .hero-panel {
    border-top: 1px solid var(--sb-line);
    padding: 2rem var(--sb-gutter) 2.5rem;
  }

  .hero-panel-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }

  .hero-glyphs {
    display: flex;
    gap: 0.75rem;
  }

  /* Each glyph is parked under a clipping window and rolls up into it. */
  .hero-glyph {
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 0.375rem;
    inline-size: 3rem;
    block-size: 3rem;
    background-color: var(--sb-accent);
    color: var(--sb-accent-ink);
  }

  .hero-glyph-inner {
    display: grid;
    place-items: center;
    inline-size: 100%;
    block-size: 100%;
  }

  .hero-statement {
    font-size: clamp(1.0625rem, 1.5vw, 1.375rem);
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--band-ink);
    text-wrap: pretty;
  }

  .hero-statement > span {
    display: block;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-glyph-inner,
    .hero-statement > span,
    .hero-ctas {
      animation: hero-enter 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: var(--start, 0ms);
    }

    .hero-glyph-inner {
      animation-name: hero-roll-up;
      animation-delay: calc(var(--start, 0ms) + var(--i, 0) * 80ms);
    }

    .hero-statement > span:nth-child(2) {
      animation-delay: calc(var(--start, 0ms) + 90ms);
    }
    .hero-statement > span:nth-child(3) {
      animation-delay: calc(var(--start, 0ms) + 180ms);
    }
    .hero-ctas {
      animation-delay: calc(var(--start, 0ms) + 300ms);
    }
  }

  @keyframes hero-roll-up {
    from {
      transform: translateY(100%);
    }
    to {
      transform: none;
    }
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* -------------------------------------------------------------- furniture */
  .hero-media {
    order: 2;
    padding: 0;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-top: 1px solid var(--sb-line);
  }

  .hero-panel {
    order: 1;
  }

  .hero-aside {
    display: none;
  }

  .hero-card {
    display: block;
    border: 1px solid var(--sb-line);
    border-radius: 0.5rem;
    padding: 1rem;
    background-color: var(--sb-bg);
    transition: background-color 0.2s;
  }

  .hero-card:hover {
    background-color: var(--sb-hover);
  }

  .hero-card-arrow {
    display: inline-block;
    transition: transform 0.2s;
  }

  .hero-card:hover .hero-card-arrow {
    transform: translateX(0.15rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-arrows,
    .hero-card {
      animation: hero-enter 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: var(--start, 0ms);
    }
  }

  /* ===========================================================================
     Desktop — the quadrant grid
     ========================================================================= */
  @media (min-width: 1024px) {
    .hero-grid {
      display: grid;
      grid-template-columns: 70% 30%;
      grid-template-rows: 60% 40%;
      block-size: max(34rem, calc(100dvh - var(--sb-nav-h)));
    }

    .hero-cell {
      padding: 2.5rem;
    }

    .hero-title-cell {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: flex-start;
      border-right: 1px solid var(--sb-line);
      /* So the title can be sized from the COLUMN rather than the viewport.
         A vw clamp large enough to fill this cell at 1440 overshoots it at
         1024 and the line runs off the edge. */
      container-type: inline-size;
    }

    .hero-title {
      /* ~12.7 characters to the em in Geist at this tracking, and the longest
         line is 25 — so a shade under a twelfth of the column per character. */
      font-size: min(8cqw, 5rem);
    }

    .hero-line {
      display: flex;
      align-items: flex-end;
    }

    /*
      The line itself is a second mask that unrolls, so the block opens as the
      characters rise into it — the other half of their SplitText intro. It is
      the one thing here that animates a box rather than a transform, and it is
      confined to two lines inside a bottom-anchored cell, so nothing outside
      the title lays out again.
    */
    @media (prefers-reduced-motion: no-preference) {
      .hero-line {
        block-size: 1.16em;
        overflow: hidden;
        animation: hero-line-open 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
        animation-delay: var(--d, 0ms);
      }
    }

    @keyframes hero-line-open {
      from {
        block-size: 0;
      }
      to {
        block-size: 1.16em;
      }
    }

    .hero-eyebrow {
      margin-bottom: 0;
    }

    .hero-media {
      grid-column: 1;
      grid-row: 2;
      padding: 0;
      border-right: 1px solid var(--sb-line);
      border-top: 1px solid var(--sb-line);
      justify-content: center;
    }

    .hero-aside {
      grid-column: 2;
      grid-row: 2;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: stretch;
      gap: 1.5rem;
      border-top: 1px solid var(--sb-line);
      overflow: hidden;
    }

    /*
      Absolutely positioned over the top-right quadrant rather than placed in
      it, because the scroll animation grows it out of that quadrant and over
      everything else. clip-path — not width — so nothing lays out again, and
      so it stops taking pointer events outside the visible area.
    */
    .hero-panel {
      position: absolute;
      inset: 0;
      z-index: 2;
      clip-path: inset(0 0 40% 70%);
      border-top: 0;
      padding: 0;
    }

    .hero-panel-body {
      position: absolute;
      inset-block: 0 40%;
      inset-inline: 70% 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 2.5rem;
      gap: 1.5rem;
    }

    /* Sized so the three written lines stay three lines in the column. */
    .hero-statement {
      font-size: clamp(1.0625rem, 1.45vw, 1.25rem);
    }
  }

  /* ===========================================================================
     Desktop scroll act — pin for one screen, then hand the screen to the panel
     ========================================================================= */
  @supports (animation-timeline: scroll()) {
    @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
      .hero-shell {
        block-size: 200dvh;
      }

      .hero-frame {
        position: sticky;
        top: var(--sb-nav-h);
      }

      /* cq units below are measured against this box. */
      .hero-grid {
        container-type: size;
      }

      /*
        No animation-duration: on a progress-based timeline the initial `auto`
        maps the whole keyframe list onto the range below. Giving it a time
        would collapse the effect into the first instant of the scroll.
      */
      .hero-title-cell,
      .hero-media,
      .hero-aside-top,
      .hero-aside-bottom,
      .hero-panel,
      .hero-panel-body {
        animation-timeline: scroll(root block);
        animation-range: 0 100vh;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      .hero-title-cell,
      .hero-media {
        animation-name: hero-clear-up;
      }
      .hero-aside-top {
        animation-name: hero-clear-out;
      }
      .hero-aside-bottom {
        animation-name: hero-clear-down;
      }
      .hero-panel {
        animation-name: hero-panel-open;
      }
      .hero-panel-body {
        animation-name: hero-panel-centre;
      }
    }
  }

  @keyframes hero-clear-up {
    to {
      transform: translateY(-60dvh);
      opacity: 0;
    }
  }

  /* Only has to leave its own cell — the aside clips. */
  @keyframes hero-clear-out {
    to {
      transform: translateY(-140%);
      opacity: 0;
    }
  }

  @keyframes hero-clear-down {
    to {
      transform: translateY(120%);
      opacity: 0;
    }
  }

  @keyframes hero-panel-open {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /*
    The body sits centred in a box spanning 70–100% across and 0–60% down, so
    its centre is at (85cqw, 30cqh). Moving it to the middle of the frame is
    therefore exactly -35cqw / +20cqh — no measuring, unlike their GSAP version.
  */
  @keyframes hero-panel-centre {
    to {
      transform: translate(-35cqw, 20cqh) scale(1.06);
    }
  }
</style>
