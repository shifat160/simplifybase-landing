---
/**
 * A browser/app chrome frame for product mockups, resolving against the
 * enclosing band so it works on white, near-black and saturated colour.
 *
 * Purely decorative: the whole frame is aria-hidden, so anything meaningful
 * inside it must also be stated in the surrounding copy.
 */
interface Props {
  label?: string;
  class?: string;
}

const { label = 'app.simplifybase.com', class: className = '' } = Astro.props;
---

<div
  aria-hidden="true"
  class={`overflow-hidden rounded-xl border border-[var(--band-line)] bg-[var(--band-bg)] select-none ${className}`}
>
  <div
    class="flex items-center gap-2 border-b border-[var(--band-line)] px-4 py-2.5"
  >
    <span class="flex gap-1.5">
      <span class="size-2 rounded-full bg-[var(--band-line)]"></span>
      <span class="size-2 rounded-full bg-[var(--band-line)]"></span>
      <span class="size-2 rounded-full bg-[var(--band-line)]"></span>
    </span>
    <span class="text-caption mx-auto">{label}</span>
  </div>

  <div class="p-4 sm:p-5">
    <slot />
  </div>
</div>
