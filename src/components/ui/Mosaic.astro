---
/**
 * The pixel-mosaic motif — a grid of squares that dissolves from solid to
 * empty across its width, in a ramp built from the page's accent.
 *
 * Every colour is a color-mix against var(--sb-accent), so a product page's
 * mosaic takes that product's hue for free.
 *
 * Deterministic: the pattern is a pure function of `seed`, not Math.random.
 * A random pattern would change on every build, churning the diff of every
 * page that uses one and making visual regressions impossible to spot.
 */
interface Props {
  cols?: number;
  rows?: number;
  /** Any string. Same seed, same pattern, forever. */
  seed?: string;
  /** Direction the mosaic dissolves towards. */
  fade?: 'right' | 'left' | 'none';
  class?: string;
}

const {
  cols = 28,
  rows = 8,
  seed = 'simplifybase',
  fade = 'right',
  class: className = '',
} = Astro.props;

// FNV-1a, then mulberry32. Small, dependency-free, and stable across Node
// versions — which a hash based on string indices would not be.
function makeRandom(input: string) {
  let h = 2166136261;
  for (let i = 0; i < input.length; i++) {
    h ^= input.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  let state = h >>> 0;
  return () => {
    state |= 0;
    state = (state + 0x6d2b79f5) | 0;
    let t = Math.imul(state ^ (state >>> 15), 1 | state);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const RAMP = [
  'var(--sb-accent)',
  'color-mix(in oklab, var(--sb-accent) 80%, #ffffff)',
  'color-mix(in oklab, var(--sb-accent) 55%, #ffffff)',
  'color-mix(in oklab, var(--sb-accent) 85%, #c81e3c)',
  'color-mix(in oklab, var(--sb-accent) 65%, #ffcf5c)',
];

const rand = makeRandom(seed);

const cells: { key: string; colour: string | null }[] = [];
for (let y = 0; y < rows; y++) {
  for (let x = 0; x < cols; x++) {
    // Fill probability ramps down across the axis, so the block reads as solid
    // at one edge and scattered at the other.
    const t = cols === 1 ? 0 : x / (cols - 1);
    const progress = fade === 'left' ? 1 - t : t;
    // Never reaches zero: a tail that empties completely reads as a truncated
    // image rather than as a deliberate dissolve. 0.12 keeps a scatter of
    // squares all the way to the far edge.
    const probability = fade === 'none' ? 0.85 : 1.02 - progress * 0.9;

    const filled = rand() < probability;
    // Drawn even when empty so the grid keeps its shape.
    const colour = filled ? RAMP[Math.floor(rand() * RAMP.length)]! : null;
    cells.push({ key: `${x}-${y}`, colour });
  }
}
---

<div
  aria-hidden="true"
  class={`grid w-full select-none ${className}`}
  style={`grid-template-columns:repeat(${cols},minmax(0,1fr));aspect-ratio:${cols}/${rows}`}
>
  {
    cells.map((cell) => (
      <span
        style={cell.colour ? `background-color:${cell.colour}` : undefined}
        class="block aspect-square"
      />
    ))
  }
</div>
