---
/**
 * Product glyphs, drawn rather than sourced.
 *
 * Deliberately not from an icon library: those catalogue *other people's*
 * brands (WooCommerce, Slack, Stripe) and are the right answer for the
 * integrations row, not for our own products — a third-party app icon standing
 * in for SimplifyStock would be someone else's mark on our tile.
 *
 * All five are built from the same vocabulary as the logo: stacked bars,
 * squares on a grid, 1.6 stroke. They read as one family at 24px.
 */
interface Props {
  slug: string;
  class?: string;
}

const { slug, class: className = 'size-5' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  {/* Stock — stacked crates, one lifted: inventory with a level to watch. */}
  {
    slug === 'simplifystock' && (
      <>
        <rect x="3" y="14" width="7" height="7" rx="1" />
        <rect x="14" y="14" width="7" height="7" rx="1" />
        <rect x="8.5" y="4" width="7" height="7" rx="1" />
      </>
    )
  }

  {/* Commerce — one input routed to three destinations. */}
  {
    slug === 'simplifycommerce' && (
      <>
        <path d="M3 12h5" />
        <path d="M8 12c4 0 4-7 8-7h5M8 12c4 0 4 7 8 7h5" />
        <circle cx="3" cy="12" r="1.6" />
        <circle cx="21" cy="5" r="1.6" />
        <circle cx="21" cy="19" r="1.6" />
      </>
    )
  }

  {/* SMTP — envelope with a delivery tick. */}
  {
    slug === 'simplifysmtp' && (
      <>
        <path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h15A1.5 1.5 0 0 1 21 7.5v5" />
        <path d="M3 7.5v9A1.5 1.5 0 0 0 4.5 18h8" />
        <path d="m3.5 7 8.5 6 8.5-6" />
        <path d="m15.5 17.5 2 2 4-4" />
      </>
    )
  }

  {/* Press — a page with a pending change marked on it. */}
  {
    slug === 'simplifypress' && (
      <>
        <rect x="3" y="4" width="18" height="16" rx="1.5" />
        <path d="M3 8.5h18" />
        <path d="M7 12.5h5M7 16h8" />
        <circle cx="5.4" cy="6.25" r="0.6" fill="currentColor" stroke="none" />
      </>
    )
  }

  {/* Apps — a form field feeding a grid of views. */}
  {
    slug === 'simplifyapps' && (
      <>
        <rect x="3" y="3" width="8" height="8" rx="1" />
        <rect x="13" y="3" width="8" height="5" rx="1" />
        <rect x="3" y="13" width="8" height="8" rx="1" />
        <rect x="13" y="10" width="8" height="11" rx="1" />
      </>
    )
  }
</svg>
