---
/**
 * Product glyphs, drawn rather than sourced.
 *
 * Deliberately not from an icon library: those catalogue *other people's*
 * brands (WooCommerce, Slack, Stripe) and are the right answer for the
 * integrations row, not for our own products — a third-party app icon standing
 * in for SimplifyStock would be someone else's mark on our tile.
 *
 * All five are built from the same vocabulary as the logo: stacked bars,
 * squares on a grid, 1.6 stroke. They read as one family at 24px.
 */
interface Props {
  slug: string;
  class?: string;
}

const { slug, class: className = 'size-5' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  {/* Stock — stacked crates, one lifted: inventory with a level to watch. */}
  {
    slug === 'simplifystock' && (
      <>
        <rect x="3" y="14" width="7" height="7" rx="1" />
        <rect x="14" y="14" width="7" height="7" rx="1" />
        <rect x="8.5" y="4" width="7" height="7" rx="1" />
      </>
    )
  }

  {/* Search — a lens over the grid of products it is reading. */}
  {
    slug === 'simplifysearch' && (
      <>
        <rect x="3" y="3" width="7" height="7" rx="1" />
        <rect x="14" y="3" width="7" height="7" rx="1" />
        <rect x="3" y="14" width="7" height="7" rx="1" />
        <circle cx="17" cy="17" r="4" />
        <path d="m20 20 1.5 1.5" />
      </>
    )
  }

  {/* Flow — a channel with a thread hanging off it. */}
  {
    slug === 'simplifyflow' && (
      <>
        <path d="M3 5.5A1.5 1.5 0 0 1 4.5 4h11A1.5 1.5 0 0 1 17 5.5v5A1.5 1.5 0 0 1 15.5 12H8l-3 3v-3H4.5A1.5 1.5 0 0 1 3 10.5z" />
        <path d="M11 15.5A1.5 1.5 0 0 1 12.5 14h6A1.5 1.5 0 0 1 20 15.5v2A1.5 1.5 0 0 1 18.5 19H16l-2 2v-2h-1.5A1.5 1.5 0 0 1 11 17.5z" />
      </>
    )
  }

  {/* Roster — a day's timeline: two covered spans and the gap between them. */}
  {
    slug === 'simplifyroster' && (
      <>
        <rect x="3" y="4" width="18" height="16" rx="1.5" />
        <path d="M3 8.5h18" />
        <path d="M6 12.5h6M15 12.5h3" />
        <path d="M6 16h3M12 16h6" />
        <circle cx="5.4" cy="6.25" r="0.6" fill="currentColor" stroke="none" />
      </>
    )
  }

  {/* Video — a frame with a play head, over the strip of scenes it cuts from. */}
  {
    slug === 'simplifyvideo' && (
      <>
        <rect x="3" y="4" width="18" height="11" rx="1.5" />
        <path d="M10.5 7.5 14.5 9.75l-4 2.25z" />
        <path d="M4 18.5h4M10 18.5h4M16 18.5h4" />
      </>
    )
  }
</svg>
