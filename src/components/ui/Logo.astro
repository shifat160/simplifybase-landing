---
/**
 * The mark is a base plinth with two layers stacked on it, shrinking upward —
 * "a base you build products on", and a literal reading of the wordmark. It is
 * drawn in currentColor so it inherits whatever text colour it sits in; only
 * the top layer is coloured, and it uses --sb-brand rather than --sb-accent so
 * it stays SimplifyBase amber on product pages that re-point the accent.
 */
interface Props {
  /** Renders the mark alone, without the wordmark. */
  markOnly?: boolean;
  class?: string;
}

const { markOnly = false, class: className = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
    class="size-6 shrink-0 text-ink"
  >
    <rect x="2" y="16" width="20" height="6" rx="2" fill="currentColor"></rect>
    <rect
      x="5"
      y="9"
      width="14"
      height="5"
      rx="1.75"
      fill="currentColor"
      opacity="0.55"></rect>
    <rect
      x="8.5"
      y="2"
      width="7"
      height="5"
      rx="1.75"
      fill="var(--sb-brand)"></rect>
  </svg>

  {
    !markOnly && (
      <span class="text-[0.9375rem] font-medium tracking-[-0.02em] text-ink">
        SimplifyBase
      </span>
    )
  }
</span>
