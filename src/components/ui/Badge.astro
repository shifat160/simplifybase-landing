---
/**
 * Small mono pill. Resolves against the enclosing band so it stays legible on
 * white, near-black and orange alike. `tone` matches the product status
 * vocabulary so Live / Beta / Planned look the same everywhere.
 */
interface Props {
  tone?: 'default' | 'accent' | 'live' | 'beta' | 'planned';
  class?: string;
}

const { tone = 'default', class: className = '' } = Astro.props;

const onBand =
  'border-[var(--band-line,var(--sb-line))] text-[var(--band-muted,var(--sb-muted))]';

const tones = {
  default: onBand,
  // Only `accent` reaches for the brand colour; on an accent band that would
  // be invisible, so it falls back to the band's own contrast pair.
  accent:
    'border-[var(--band-line,var(--sb-line))] bg-[var(--band-fill,var(--sb-ink))] text-[var(--band-fill-ink,var(--sb-bg))]',
  live: `${onBand} text-[var(--band-ink,var(--sb-ink))]`,
  beta: onBand,
  planned: onBand,
};

const dotted = tone === 'live';
---

<span
  class={`inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 font-mono text-[0.6875rem] leading-5 tracking-[0.08em] uppercase ${tones[tone]} ${className}`}
>
  {
    dotted && (
      <span class="relative flex size-1.5">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-70" />
        <span class="relative inline-flex size-1.5 rounded-full bg-accent" />
      </span>
    )
  }
  <slot />
</span>
