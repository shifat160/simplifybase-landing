---
/**
 * Bordered surface. Resolves against the enclosing band, so a card on a
 * near-black band gets that band's hairline rather than the page's.
 *
 * Square-ish corners and a 1px border, no shadow — elevation in this design
 * comes from colour, not blur.
 */
interface Props {
  href?: string;
  interactive?: boolean;
  padded?: boolean;
  /** Fills the card with the band's own surface instead of leaving it clear. */
  filled?: boolean;
  class?: string;
}

const {
  href,
  interactive = Boolean(href),
  padded = true,
  filled = false,
  class: className = '',
} = Astro.props;

const cls = [
  'relative rounded-xl border border-[var(--band-line,var(--sb-line))]',
  filled && 'bg-[var(--band-bg,var(--sb-bg))]',
  padded && 'p-5 sm:p-6',
  interactive &&
    'transition-colors duration-200 hover:border-[var(--band-ink,var(--sb-ink))]',
  className,
]
  .filter(Boolean)
  .join(' ');
---

{
  href ? (
    <a href={href} class={`${cls} block`}>
      <slot />
    </a>
  ) : (
    <div class={cls}>
      <slot />
    </div>
  )
}
