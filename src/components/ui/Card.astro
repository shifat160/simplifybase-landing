---
/**
 * The bordered surface everything sits on. Hairline border, no drop shadow —
 * elevation in this design comes from the border and a background step, never
 * from a blur.
 */
interface Props {
  href?: string;
  /** Adds hover affordances. Implied when href is set. */
  interactive?: boolean;
  padded?: boolean;
  class?: string;
}

const {
  href,
  interactive = Boolean(href),
  padded = true,
  class: className = '',
} = Astro.props;

const cls = [
  'relative rounded-xl border border-line bg-surface',
  padded && 'p-6 sm:p-7',
  interactive &&
    'transition-colors duration-200 hover:border-line-strong hover:bg-surface-2',
  className,
]
  .filter(Boolean)
  .join(' ');
---

{
  href ? (
    <a href={href} class={`${cls} block`}>
      <slot />
    </a>
  ) : (
    <div class={cls}>
      <slot />
    </div>
  )
}
